# The Odds API key -- free tier, 500 credits/month. https://the-odds-api.com
ODDS_API_KEY=

# Path to the SQLite file. On Railway set this to a path inside the mounted
# volume (e.g. /data/pigskin.db) or every redeploy starts a fresh season.
PIGSKIN_DB=pigskin.db

# The Tuesday 00:00 UTC that opens NFL Week 1. Games are bucketed into weeks
# in 7-day blocks from this anchor. Correct it if your slate lands in the
# wrong week (the UI shows the computed week for every game).
SEASON_WEEK1_ANCHOR=2026-09-08
